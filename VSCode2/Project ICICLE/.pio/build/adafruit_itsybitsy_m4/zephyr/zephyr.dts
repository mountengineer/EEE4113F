		nvmctrl: nvmctrl@41004000 {
			compatible = "atmel,sam0-nvmctrl";
			label = "FLASH_CTRL";
			reg = < 0x41004000 0x22 >;
			interrupts = < 0x1d 0x0 >, < 0x1e 0x0 >;
			lock-regions = < 0x20 >;
			#address-cells = < 0x1 >;
			#size-cells = < 0x1 >;
			flash0: flash@0 {
				compatible = "soc-nv-flash";
				label = "FLASH_0";
				write-block-size = < 0x8 >;
				reg = < 0x0 0x80000 >;
				partitions {
					compatible = "fixed-partitions";
					#address-cells = < 0x1 >;
					#size-cells = < 0x1 >;
					boot_partition: partition@0 {
						label = "uf2";
						reg = < 0x0 0x4000 >;
						read-only;
					};
					code_partition: partition@4000 {
						label = "code";
						reg = < 0x4000 0x78000 >;
						read-only;
					};
					storage_partition: partition@7c000 {
						label = "storage";
						reg = < 0x7c000 0x4000 >;
					};
				};
			};
		};
		dmac: dmac@4100a000 {
			compatible = "atmel,sam0-dmac";
			reg = < 0x4100a000 0x50 >;
