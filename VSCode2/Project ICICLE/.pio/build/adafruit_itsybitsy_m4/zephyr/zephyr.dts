/dts-v1/;

/ {
	#address-cells = < 0x1 >;
	#size-cells = < 0x1 >;
	model = "Adafruit ItsyBitsy M4 Express";
	compatible = "adafruit,itsybitsy-m4-express";
	chosen {
		zephyr,flash-controller = &nvmctrl;
		zephyr,entropy = &trng;
		zephyr,console = &sercom3;
		zephyr,shell-uart = &sercom3;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &code_partition;
	};
	aliases {
		adc-0 = &adc0;
		adc-1 = &adc1;
		port-a = &porta;
		port-b = &portb;
		port-c = &portc;
		port-d = &portd;
		sercom-0 = &sercom0;
		sercom-1 = &sercom1;
		sercom-2 = &sercom2;
		sercom-3 = &sercom3;
		sercom-4 = &sercom4;
		sercom-5 = &sercom5;
		sercom-6 = &sercom6;
		sercom-7 = &sercom7;
		tc-0 = &tc0;
		tc-2 = &tc2;
		tc-4 = &tc4;
		tc-6 = &tc6;
		tcc-0 = &tcc0;
		tcc-1 = &tcc1;
		tcc-2 = &tcc2;
		tcc-3 = &tcc3;
		tcc-4 = &tcc4;
		watchdog0 = &wdog;
		led0 = &led0;
		pwm-led0 = &pwm_led0;
		pwm-0 = &tcc0;
	};
	soc {
		#address-cells = < 0x1 >;
		#size-cells = < 0x1 >;
		compatible = "simple-bus";
		interrupt-parent = < &nvic >;
		ranges;
		nvic: interrupt-controller@e000e100 {
			#address-cells = < 0x1 >;
			compatible = "arm,v7m-nvic";
			reg = < 0xe000e100 0xc00 >;
			interrupt-controller;
			#interrupt-cells = < 0x2 >;
			arm,num-irq-priority-bits = < 0x3 >;
			phandle = < 0x1 >;
		};
		systick: timer@e000e010 {
			compatible = "arm,armv7m-systick";
			reg = < 0xe000e010 0x10 >;
		};
		pinctrl@41008000 {
			compatible = "atmel,sam0-pinctrl";
			#address-cells = < 0x1 >;
			#size-cells = < 0x1 >;
			ranges = < 0x41008000 0x41008000 0x200 >;
			pa8c_sercom0_pad0: pa8c_sercom0_pad0 {
				atmel,pins = < &porta 0x8 0x2 >;
				pinmux-enable;
			};
			pa9c_sercom0_pad1: pa9c_sercom0_pad1 {
				atmel,pins = < &porta 0x9 0x2 >;
				pinmux-enable;
			};
			pa10c_sercom0_pad2: pa10c_sercom0_pad2 {
				atmel,pins = < &porta 0xa 0x2 >;
				pinmux-enable;
			};
			pa11c_sercom0_pad3: pa11c_sercom0_pad3 {
				atmel,pins = < &porta 0xb 0x2 >;
				pinmux-enable;
			};
			pb24c_sercom0_pad0: pb24c_sercom0_pad0 {
				atmel,pins = < &portb 0x18 0x2 >;
				pinmux-enable;
			};
			pb25c_sercom0_pad1: pb25c_sercom0_pad1 {
				atmel,pins = < &portb 0x19 0x2 >;
